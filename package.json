{
  "name": "terminal-use",
  "version": "0.1.0",
  "mcpName": "io.github.computer-agent-labs/terminal-use",
  "description": "MCP server that lets AI agents drive a real PTY/TTY",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "terminal",
    "pty",
    "tty",
    "tui",
    "ai-agent",
    "claude"
  ],
  "author": "Computer Agent Labs, Inc.",
  "homepage": "https://github.com/computer-agent-labs/terminal-use#readme",
  "bugs": {
    "url": "https://github.com/computer-agent-labs/terminal-use/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/computer-agent-labs/terminal-use.git"
  },
  "bin": {
    "terminal-use": "./bin/terminal-use.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "fonts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"for (const d of ['dist', 'build']) require('fs').rmSync(d, {recursive: true, force: true})\"",
    "build": "node -e \"for (const d of ['dist', 'build']) require('fs').rmSync(d, {recursive: true, force: true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "start": "npm run build && node bin/terminal-use.js",
    "dev": "tsx src/bin/terminal-use-main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:mcp": "vitest run tests/mcp",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@modelcontextprotocol/server": "^2.2.0",
    "@napi-rs/canvas": "^1.0.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9.16.0",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "publishConfig": {
    "access": "public"
  }
}
